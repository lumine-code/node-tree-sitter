{
  "name": "@lumine-code/node-tree-sitter",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides native Tree-sitter bindings with portable Wasm grammars.",
  "repository": "https://github.com/lumine-code/node-tree-sitter",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "types": "tree-sitter.d.ts",
  "keywords": [
    "tree-sitter",
    "webassembly",
    "incremental",
    "parsing",
    "node-api"
  ],
  "files": [
    "index.js",
    "background-parser.js",
    "text-edits.js",
    "binding.gyp",
    "tree-sitter.d.ts",
    "prebuilds",
    "src",
    "script",
    "test",
    "benchmark",
    "docs",
    "vendor/tree-sitter/lib",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/tmp": "^0.2.6",
    "electron": "44.9.0",
    "eslint": "^10.13.0",
    "node-gyp": "^13.1.0",
    "prebuildify": "^6.0.1",
    "prettier": "^3.9.10",
    "tmp": "^0.2.7",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-embedded-template": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^7.0.2",
    "web-tree-sitter": "0.27.1"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "prebuildify --napi --strip",
    "rebuild": "node-gyp rebuild",
    "test": "node script/test.js",
    "setup:wasmtime": "node script/setup-wasmtime.js",
    "setup:runtime": "node script/setup-tree-sitter.js",
    "lint": "eslint index.js background-parser.js text-edits.js script test/api_test.js test/wasm_test.js test/review_test.js test/lifecycle_test.js test/predicates_test.js test/final_review_test.js benchmark",
    "benchmark": "node benchmark/wasm.js",
    "test:electron": "node script/electron-test.js",
    "check:types": "tsc --ignoreConfig --noEmit --strict --module node16 --target es2022 test/types.ts"
  },
  "bugs": "https://github.com/lumine-code/node-tree-sitter/issues",
  "engines": {
    "node": ">=24.18.0"
  }
}
